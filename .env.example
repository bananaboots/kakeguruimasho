# Cloud sync (optional). Leave both blank for local-only single-device
# behaviour — the legacy IDB persist layer stays in charge and the
# sign-in screen is not shown.
#
# See CLOUD_SYNC_SETUP.md for how to get these values.

# Clerk — publishable key is safe to ship in the client bundle.
VITE_CLERK_PUBLISHABLE_KEY=

# PartyKit host for the Yjs relay. e.g. kakeguruimasho-sync.<your-user>.partykit.dev
VITE_PARTYKIT_HOST=
